<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quantity_history_inherit_custom_report_date" model="ir.ui.view">
        <field name="name">stock.quantity.history.form.custom.report.date</field>
        <field name="model">stock.quantity.history</field>
        <field name="inherit_id" ref="stock.view_stock_quantity_history"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inventory_datetime']" position="after">
                <field name="use_move_inventory_report_date"/>
            </xpath>
        </field>
    </record>
</odoo>
